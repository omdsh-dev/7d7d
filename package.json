{
  "name": "@mattheliu/7d7d",
  "version": "0.4.0-rc.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.12.3",
  "engines": {
    "node": ">=22"
  },
  "description": "7d7d —— 7k7k 风格的 DSH 游戏门户：在 Web UI 内生成、同步并游玩 HTML5 与自托管 Ruffle Flash 小游戏。",
  "keywords": [
    "dsh-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omdsh-dev/7d7d.git"
  },
  "homepage": "https://github.com/omdsh-dev/7d7d#readme",
  "bugs": {
    "url": "https://github.com/omdsh-dev/7d7d/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "seed-games",
    "community-games",
    "catalog.json",
    "skills",
    "scripts",
    "vendor/ruffle/README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "pack:check": "node scripts/check-package-tarball.mjs",
    "fetch:ruffle": "node scripts/fetch-ruffle.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.4",
    "@deepseek-ai/dsh-client-runtime": "0.0.1-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.0.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.0.1-rc.5",
    "@deepseek-ai/dsh-host-webserver": "0.0.1-rc.5",
    "@deepseek-ai/schemastery": "^3.18.1-rc.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1-rc.4",
    "@deepseek-ai/dsh-client-runtime": "0.0.1-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.0.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.0.1-rc.5",
    "@deepseek-ai/dsh-host-webserver": "0.0.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.1-rc.4",
    "@types/node": "22.20.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "lightningcss": "1.32.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
